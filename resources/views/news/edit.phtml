<?php View::pushunique('javascript') ?>
<script>
  (function () {
    const editors = document.querySelectorAll('textarea.html-edit');

    if (editors.length === 0) {
      return;
    }

    const ckeditorPath = <?= json_encode(asset('ckeditor-4.15.1-custom/'), JSON_THROW_ON_ERROR) ?>;

    function activateEditors() {
      if (!window.CKEDITOR) {
        return;
      }

      CKEDITOR.env.isCompatible = true;
      CKEDITOR.config.language = <?= json_encode(strtolower(I18N::locale()->language()->code()), JSON_THROW_ON_ERROR) ?>;
      CKEDITOR.config.removePlugins = 'forms,newpage,preview,print,save,templates,flash,iframe';
      CKEDITOR.config.extraAllowedContent =
        'area[shape,coords,href,target,alt,title];' +
        'map[name];' +
        'img[usemap];' +
        'audio[controls,src];' +
        'video[controls,height,poster,src,width];' +
        '*{*}(*)';
      CKEDITOR.config.entities = false;

      editors.forEach(function (editor) {
        if (!CKEDITOR.instances[editor.id]) {
          CKEDITOR.replace(editor.id);
        }
      });
    }

    if (window.CKEDITOR) {
      activateEditors();
      return;
    }

    const existingScript = document.querySelector('script[data-user-news-ckeditor]');

    if (existingScript) {
      existingScript.addEventListener('load', activateEditors, { once: true });
      return;
    }

    window.CKEDITOR_BASEPATH = ckeditorPath;

    const script = document.createElement('script');
    script.src = ckeditorPath + 'ckeditor.js';
    script.type = 'text/javascript';
    script.dataset.userNewsCkeditor = 'true';
    script.addEventListener('load', activateEditors, { once: true });

    document.head.appendChild(script);
  })();
</script>
<?php View::endpushunique() ?>
